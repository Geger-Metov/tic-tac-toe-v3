POSTGRES_USER=user
POSTGRES_PASSWORD=user
POSTGRES_DB=ttt_db
# Порт, на котором PostgreSQL будет доступен снаружи
POSTGRES_PORT=5432

# Порт, на котором ваше FastAPI-приложение будет доступно снаружи
APP_PORT=8000

# Секрет для подписи JWT — ОБЯЗАТЕЛЬНО смени на что-то случайное в реальном
# использовании (например: openssl rand -hex 32). Без него приложение
# откажется стартовать (см. infrastructure/security/jwt_config.py).
# Значение ниже приложение отвергнет (оно начинается с change-me) — подставь свой:
JWT_SECRET_KEY=change-me-run-openssl-rand-hex-32
# Время жизни accessToken (минуты) и refreshToken (дни) — см. общую
# информацию задания: accessToken короткоживущий и переиспользуемый,
# refreshToken долгоживущий и одноразовый.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Порт, на котором Redis будет доступен снаружи (для локального запуска и тестов)
REDIS_PORT=6379

# Защита логина от перебора: не более LOGIN_MAX_ATTEMPTS попыток входа за
# LOGIN_ATTEMPT_WINDOW_SECONDS секунд для одного логина, дальше вход блокируется
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=60

# RabbitMQ — брокер сообщений для Celery. Логин/пароль НЕ guest/guest: у guest
# RabbitMQ разрешает вход только с localhost, а воркер живёт в другом контейнере.
# Избегай в пароле спецсимволов (он подставляется в URL подключения в compose).
RABBITMQ_USER=ttt
RABBITMQ_PASSWORD=ttt
RABBITMQ_PORT=5672
# Веб-интерфейс RabbitMQ: http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672

# Фоновая очистка брошенных игр (Celery): игра, в которую за
# ABANDONED_GAME_MAX_AGE_HOURS часов никто не присоединился, удаляется;
# запускается раз в CLEANUP_INTERVAL_MINUTES минут.
ABANDONED_GAME_MAX_AGE_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
